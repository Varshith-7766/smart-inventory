# Copy to .env and adjust. Never commit the real .env file.

# Flask entry point (backend/app.py contains the WSGI `application`).
FLASK_APP=app.py
FLASK_ENV=development

# Session signing key. LEAVE EMPTY to auto-generate a random key at startup
# (sessions are invalidated on every restart). Set a long random value in
# production so sessions survive restarts. Known-weak placeholders are
# rejected and replaced with a generated key automatically.
SECRET_KEY=

# MySQL (default used by docker-compose). SQLite is the fallback if unset.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_inventory

# Set to "true" when serving over HTTPS (production).
SESSION_COOKIE_SECURE=false

# Comma-separated list of extra frontend origins allowed for credentialed
# CORS. The frontend is served same-origin, so empty is the default.
ALLOWED_ORIGINS=

# IoT simulator: API key of a registered device (see POST /api/iot/devices/register).
IOT_API_KEY=

PREDICTION_INTERVAL_DAYS=7
LOW_STOCK_THRESHOLD=10